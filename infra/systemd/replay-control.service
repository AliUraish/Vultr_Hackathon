[Unit]
Description=Replay control plane (FastAPI + orchestrator), VM A
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=replay
Group=replay
WorkingDirectory=/opt/replay
EnvironmentFile=/etc/replay/control.env
ExecStart=/opt/replay/.venv/bin/python -m uvicorn control.app:app --host 0.0.0.0 --port 8000 --proxy-headers --no-access-log
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
