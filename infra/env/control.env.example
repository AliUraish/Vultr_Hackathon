# /etc/replay/control.env on VM A (bootstrap-a.sh writes it; shown for reference)
DATABASE_URL=postgresql://replay:<generated>@127.0.0.1:5432/replay
NODE_TOKEN=<shared with VM B>
SIMNODE_URL=http://<VM_B_IP>:8100
SESSION_SECRET=<generated>
ADMIN_USER=ops
ADMIN_PASSWORD=<generated, see infra/.secrets.env>
AUTO_JOBS=1
INFERENCE_PROVIDER=openai     # openai | vultr
INFERENCE_KEY=                # empty = free rule-based diagnosis
INFERENCE_MODEL=              # optional
# INFERENCE_URL=              # only for other OpenAI-compatible endpoints
# TICK_RETENTION_HOURS=12
# COOKIE_SECURE=1             # once served over HTTPS (NetBird)
