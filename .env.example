# Copy to .env (gitignored) and fill in. Never commit .env or paste keys in chat.
# Deploy-time settings; each VM gets its own env file generated from these (see infra/).

VULTR_API_KEY=           # not used by the app; only for provisioning, and only on explicit go-ahead

VM_A_IP=                 # control plane: FastAPI + Postgres 16 + web app
VM_B_IP=                 # sim + replay workers

# Diagnosis agent LLM. Leave INFERENCE_KEY empty to use the free rule-based playbook.
INFERENCE_PROVIDER=openai   # openai | vultr (Vultr Serverless Inference)
INFERENCE_KEY=              # OpenAI API key (or Vultr inference key)
INFERENCE_MODEL=            # optional; for OpenAI defaults to gpt-4.1-mini if your key can use it
